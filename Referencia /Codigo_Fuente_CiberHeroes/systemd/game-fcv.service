[Unit]
Description=Max Heroes Doomsday FCV (static :5005)
After=network.target

[Service]
Type=simple
User=desarrollo
WorkingDirectory=/home/desarrollo/game-fcv
Environment=PORT=5005
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/node /home/desarrollo/game-fcv/server.js
Restart=always
RestartSec=5
StandardOutput=append:/home/desarrollo/game-fcv/logs/game-fcv.log
StandardError=append:/home/desarrollo/game-fcv/logs/game-fcv.log

[Install]
WantedBy=multi-user.target
